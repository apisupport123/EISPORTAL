// ---------- ADID: Remove special characters ----------
        if ("ADID".equalsIgnoreCase(columnName) && cellValue != null && !cellValue.trim().isEmpty()) {
            // Option 1: Remove ALL special characters (keep only letters and numbers)
            cellValue = cellValue.replaceAll("[^a-zA-Z0-9]", "");
            // Option 2: OR remove only _, -, space
            // cellValue = cellValue.replaceAll("[_\\-\\s]", "");
            
            // Convert to uppercase for consistency
            cellValue = cellValue.toUpperCase();
        }

// ---------- VALIDATE TEAM COLUMN WITH ALIAS SUPPORT ----------
boolean hasInvalidTeam = false;
StringBuilder teamErrors = new StringBuilder();
String normalizedSelectedTeam = team.replaceAll("\\s+", "").toLowerCase();

for (int i = 1; i <= sheet.getLastRowNum(); i++) {
    Row row = sheet.getRow(i);
    if (row == null) continue;
    
    Cell teamCell = row.getCell(columnMap.get("Team"));
    String teamValue = getCellValue(teamCell);
    
    if (teamValue == null || teamValue.trim().isEmpty()) {
        hasInvalidTeam = true;
        teamErrors.append("Row ").append(i + 1).append(": Empty Team, ");
        continue;
    }
    
    // Normalize and check for aliases
    String normalizedTeamValue = teamValue.replaceAll("\\s+", "").toLowerCase();
    String standardTeamName = null;
    
    // Map aliases to standard team names
    if (normalizedTeamValue.equals("issuemanagement") || 
        normalizedTeamValue.equals("mails")) {
        standardTeamName = "Incident Management";
    } else if (normalizedTeamValue.equals("monitoring")) {
        standardTeamName = "Event Management";
    } else if (normalizedTeamValue.equals("score")) {
        standardTeamName = "Service Desk";
    } else if (normalizedTeamValue.equals("adhoc")) {
        standardTeamName = "Service Reporting Management";
    } else if (normalizedTeamValue.equals("automation")) {
        standardTeamName = "Process Improvement";
    }
    
    // Get the normalized value for comparison
    String normalizedCompareValue = standardTeamName != null ? 
                                   standardTeamName.replaceAll("\\s+", "").toLowerCase() : 
                                   normalizedTeamValue;
    
    // Check if it matches the selected team
    if (!normalizedCompareValue.equals(normalizedSelectedTeam)) {
        hasInvalidTeam = true;
        String displayValue = standardTeamName != null ? 
                             standardTeamName + " (from alias: '" + teamValue + "')" : 
                             teamValue;
        teamErrors.append("Row ").append(i + 1).append(": '")
               .append(displayValue).append("' should be '").append(team).append("', ");
    }
}

if (hasInvalidTeam) {
    String errorMsg = "Team column errors:<br>";
    errorMsg += teamErrors.substring(0, Math.max(0, teamErrors.length() - 2));
    errorMsg += "<br><br>All rows should have Team as: <strong>" + team + "</strong>";
    errorMsg += "<br><br>Accepted values and their aliases:<br>";
    errorMsg += "• Incident Management (or: issue management, mails, ISSUE MANAGEMENT)<br>";
    errorMsg += "• Event Management (or: monitoring, MONITORING)<br>";
    errorMsg += "• Service Desk (or: score, SCORE)<br>";
    errorMsg += "• Service Reporting Management (or: adhoc, ADHOC)<br>";
    errorMsg += "• Process Improvement (or: automation, AUTOMATION)";
    
    request.setAttribute("errorMessage", errorMsg);
    request.getRequestDispatcher("/jsp/ExcelRoster.jsp").forward(request, response);
    return;
}
