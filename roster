<script>
function downloadExcel(tableId) {
try {
// Get the table element
let tableElement = document.getElementById(tableId);
if (!tableElement) {
console.error('Table not found:', tableId);
return;
}

// Clone the table to avoid modifying the original
let clonedTable = tableElement.cloneNode(true);
// Preserve background colors by adding them as data attributes or inline styles
let rows = tableElement.rows;
for (let i = 0; i < rows.length; i++) {
for (let j = 0; j < rows[i].cells.length; j++) {
let originalCell = rows[i].cells[j];
let clonedCell = clonedTable.rows[i]?.cells[j];
if (clonedCell) {
// Copy computed background color to inline style
let bgColor = window.getComputedStyle(originalCell).backgroundColor;
if (bgColor && bgColor !== 'rgba(0, 0, 0, 0)' && bgColor !== 'transparent') {
clonedCell.style.backgroundColor = bgColor;
}
// Copy font color
let textColor = window.getComputedStyle(originalCell).color;
if (textColor && textColor !== 'rgba(0, 0, 0, 0)') {
clonedCell.style.color = textColor;
}
// Copy font weight
let fontWeight = window.getComputedStyle(originalCell).fontWeight;
if (fontWeight) {
clonedCell.style.fontWeight = fontWeight;
}
}
}
}

// Convert the cloned table to worksheet
let worksheet = XLSX.utils.table_to_sheet(clonedTable, { raw: true });
// Auto-size columns (basic implementation)
let colWidths = [];
for (let i = 0; i < rows[0]?.cells.length; i++) {
let maxWidth = 10;
for (let j = 0; j < rows.length; j++) {
let cellText = rows[j].cells[i]?.innerText || '';
maxWidth = Math.max(maxWidth, cellText.length);
}
colWidths.push({ wch: Math.min(maxWidth + 2, 30) });
}
worksheet['!cols'] = colWidths;

// Create workbook and append worksheet
let workbook = XLSX.utils.book_new();
XLSX.utils.book_append_sheet(workbook, worksheet, 'ROC Roster');
// Save the file
XLSX.writeFile(workbook, 'ROC_Roster.xlsx');
console.log('Excel download initiated successfully');
} catch (error) {
console.error('Error generating Excel:', error);
alert('Error generating Excel file. Please check console for details.');
}
}

// Alternative simpler version without styling (guaranteed to work):
function downloadExcelSimple(tableId) {
try {
let tableElement = document.getElementById(tableId);
if (!tableElement) {
console.error('Table not found:', tableId);
return;
}
// Convert table to worksheet without styling
let worksheet = XLSX.utils.table_to_sheet(tableElement, { raw: true });
// Create workbook
let workbook = XLSX.utils.book_new();
XLSX.utils.book_append_sheet(workbook, worksheet, 'Team Roster');
// Save file
XLSX.writeFile(workbook, 'ROC_Roster.xlsx');
console.log('Excel download successful');
} catch (error) {
console.error('Error:', error);
alert('Error downloading Excel: ' + error.message);
}
}
</script>
