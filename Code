<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Upload Excel Roster · Modern UI</title>

  <!-- Google Font & icon library -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f6f9fc;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    .app-wrapper {
      max-width: 1300px;
      width: 100%;
    }

    /* ---- top action bar ---- */
    .action-bar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 2rem;
    }

    .btn-switch {
      background: #1e293b;
      color: #f8fafc;
      border: none;
      padding: 0.7rem 2rem;
      border-radius: 60px;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 18px rgba(0,0,0,0.04);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-switch i {
      font-size: 1rem;
      color: #facc15;
    }

    .btn-switch:hover {
      background: #0f172a;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -8px rgba(0,0,0,0.15);
    }

    /* ---- card row (grid) ---- */
    .row-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
      align-items: stretch;
    }

    .card-modern {
      background: #ffffff;
      border-radius: 2rem;
      padding: 2.5rem 2rem 2.8rem;
      box-shadow: 0 20px 40px -12px rgba(0, 20, 30, 0.08), 0 8px 24px -6px rgba(0,0,0,0.02);
      transition: transform 0.2s ease, box-shadow 0.25s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      border: 1px solid rgba(0,0,0,0.02);
      backdrop-filter: blur(2px);
    }

    .card-modern:hover {
      transform: translateY(-6px);
      box-shadow: 0 30px 50px -16px rgba(0, 40, 60, 0.12);
    }

    .card-modern .icon-big {
      font-size: 2.8rem;
      color: #7c3aed;
      background: #ede9fe;
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 40px;
      margin-bottom: 1.5rem;
    }

    .card-modern h3 {
      font-weight: 600;
      font-size: 1.5rem;
      color: #0f172a;
      margin-bottom: 0.25rem;
      letter-spacing: -0.3px;
    }

    .card-modern .sub {
      font-size: 0.9rem;
      color: #64748b;
      margin-bottom: 1.75rem;
      font-weight: 500;
    }

    /* ---- upload area (drag) ---- */
    .drag-area {
      width: 100%;
      border: 2px dashed #d1d5db;
      border-radius: 28px;
      padding: 1.8rem 0.5rem;
      margin: 0.5rem 0 1.2rem;
      transition: border 0.2s;
      background: #fafcff;
    }

    .drag-area:hover {
      border-color: #7c3aed;
      background: #f8f5ff;
    }

    .drag-area .file-label {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .drag-area .file-label i {
      font-size: 2.4rem;
      color: #7c3aed;
    }

    .drag-area .file-label span {
      font-weight: 500;
      color: #1e293b;
    }

    .drag-area .file-label .browse {
      color: #7c3aed;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .drag-area input[type="file"] {
      display: none;
    }

    /* month input */
    .month-picker {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 60px;
      font-size: 0.95rem;
      font-weight: 500;
      background: white;
      transition: 0.2s;
      color: #0f172a;
      margin: 0.5rem 0 0.8rem;
      outline: none;
    }

    .month-picker:focus {
      border-color: #7c3aed;
      box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
    }

    .month-picker::-webkit-calendar-picker-indicator {
      opacity: 0.5;
      padding: 4px;
    }

    /* sample link */
    .sample-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #f1f5f9;
      padding: 0.6rem 1.6rem;
      border-radius: 60px;
      color: #1e293b;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      transition: 0.2s;
      margin: 0.5rem 0 0.2rem;
    }

    .sample-link i {
      color: #7c3aed;
    }

    .sample-link:hover {
      background: #e2e8f0;
      transform: scale(1.01);
    }

    /* buttons */
    .btn-primary {
      background: #7c3aed;
      border: none;
      padding: 0.85rem 2.2rem;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      color: white;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 8px 18px -6px rgba(124, 58, 237, 0.3);
      transition: all 0.2s ease;
      cursor: pointer;
      border: 1px solid transparent;
      width: fit-content;
      margin-top: 0.5rem;
    }

    .btn-primary i {
      font-size: 1rem;
    }

    .btn-primary:hover {
      background: #6d28d9;
      transform: scale(1.02);
      box-shadow: 0 14px 24px -8px rgba(124, 58, 237, 0.35);
    }

    .btn-outline {
      background: transparent;
      border: 1.5px solid #d1d5db;
      padding: 0.85rem 2.2rem;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      color: #1e293b;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      transition: all 0.2s ease;
      cursor: pointer;
      width: fit-content;
      margin-top: 0.5rem;
    }

    .btn-outline i {
      color: #7c3aed;
    }

    .btn-outline:hover {
      border-color: #7c3aed;
      background: #f8f5ff;
      transform: scale(1.01);
    }

    .card-footer-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.8rem 1.2rem;
      margin-top: 0.75rem;
      width: 100%;
    }

    /* hidden helper */
    .hidden-role {
      display: none;
    }

    /* responsive */
    @media (max-width: 640px) {
      .card-modern {
        padding: 2rem 1.2rem;
      }
      .action-bar {
        justify-content: center;
      }
    }

    /* extra micro-interaction */
    .fade-in {
      animation: fadeUp 0.5s ease forwards;
    }

    @keyframes fadeUp {
      0% { opacity: 0; transform: translateY(14px); }
      100% { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
<div class="app-wrapper">

  <!-- top bar: switch to ROC -->
  <div class="action-bar">
    <button class="btn-switch" onclick="openNewRocPage()">
      <i class="fas fa-arrow-right-arrow-left"></i> Switch to ROC Roster
    </button>
  </div>

  <!-- card grid -->
  <div class="row-cards">
    <!-- ========= CARD 1: UPLOAD ROSTER ========= -->
    <div class="card-modern fade-in">
      <div class="icon-big">
        <i class="fas fa-file-upload"></i>
      </div>
      <h3>Upload Roster</h3>
      <p class="sub">Upload Excel or XML roster file</p>

      <form id="uploadForm" method="post" enctype="multipart/form-data" action="<%= request.getContextPath() + "/ExcelRosterAction_New" %>">
        <!-- month picker -->
        <input type="month" id="myMonth" name="myMonth" class="month-picker" placeholder="Select month" required />

        <!-- drag & drop area (styled) -->
        <div class="drag-area">
          <label for="fileInput" class="file-label">
            <i class="fas fa-cloud-upload-alt"></i>
            <span><span class="browse">Browse</span> or drag &amp; drop</span>
            <span style="font-size:0.8rem; color:#64748b;">.xlsx, .xls, .xml</span>
            <input type="file" id="fileInput" name="file" accept=".xlsx,.xls,.xml,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
          </label>
        </div>

        <!-- sample format link -->
        <a href='<%= request.getContextPath() + "/XMLFile/Roster_Format.xlsx" %>' class="sample-link">
          <i class="fas fa-file-excel"></i> RosterSampleFormat.xlsx
        </a>

        <!-- hidden role -->
        <input type="hidden" name="m_strroles" value="<%= (String)session.getAttribute("role") != null ? session.getAttribute("role") : "" %>" />

        <div class="card-footer-actions">
          <button type="button" class="btn-primary" onclick="insertservice()">
            <i class="fas fa-upload"></i> Upload
          </button>
        </div>
      </form>
    </div>

    <!-- ========= CARD 2: VIEW ROSTER ========= -->
    <div class="card-modern fade-in" style="animation-delay:0.08s;">
      <div class="icon-big" style="background:#e0f2fe; color:#2563eb;">
        <i class="fas fa-eye"></i>
      </div>
      <h3>View Roster</h3>
      <p class="sub">Select month to display roster</p>

      <form id="viewForm" action="<%= request.getContextPath() + "/jsp/testRoster1.jsp" %>" method="get">
        <input type="month" id="myViewMonth" name="myViewMonth" class="month-picker" placeholder="Select month" required />

        <!-- hidden role (consistent) -->
        <input type="hidden" name="m_strroles" value="<%= (String)session.getAttribute("role") != null ? session.getAttribute("role") : "" %>" />

        <div class="card-footer-actions">
          <button type="button" class="btn-outline" onclick="viewDate()">
            <i class="fas fa-calendar-alt"></i> View Roster
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- JavaScript functions (aligned with original behaviour) -->
<script>
  // ---- Upload action ----
  function insertservice() {
    var month = document.getElementById('myMonth').value;
    var fileInput = document.querySelector('#fileInput');

    if (!month) {
      alert('Please select a month.');
      return;
    }
    if (!fileInput.files || fileInput.files.length === 0) {
      alert('Please select a file to upload.');
      return;
    }

    // submit the upload form
    document.getElementById('uploadForm').submit();
  }

  // ---- View action ----
  function viewDate() {
    var month = document.getElementById('myViewMonth').value;
    if (!month) {
      alert('Please select a month.');
      return;
    }
    // submit view form
    document.getElementById('viewForm').submit();
  }

  // ---- Switch to ROC page (exact original) ----
  function openNewRocPage() {
    window.location.href = '<%= request.getContextPath() + "/jsp/ROCRoster.jsp" %>';
  }

  // ---- onload: replace history (matches original) ----
  window.onload = function() {
    // Keep the current URL in history without extra entry (like original)
    window.history.replaceState({}, 'View NightChecklist', '<%= request.getContextPath() + "/jsp/ExcelRoster_new.jsp" %>');
  };
</script>

<!-- small note: session/role is used as in original JSP -->
<!-- The role variable is printed in hidden fields, but we also keep the session logic -->
</body>
</html>
