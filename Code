<%@page import="org.apache.poi.util.SystemOutLogger"%>
<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
    pageEncoding="ISO-8859-1"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>View Excel Roster</title>
<!-- Font Awesome 6 (free) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Google Font (Inter) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

<style>
  /* ----- reset & base ----- */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: linear-gradient(145deg, #f6f9fc 0%, #e9f0f5 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  /* ----- main container (glass) ----- */
  .app-container {
    max-width: 640px;
    width: 100%;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 56px;
    padding: 2.8rem 2.5rem 3rem;
    box-shadow: 0 30px 60px -20px rgba(0, 20, 30, 0.25),
                0 8px 28px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: all 0.2s ease;
  }

  /* ----- top bar (switch button) ----- */
  .top-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2.2rem;
  }

  .btn-switch {
    background: #1e293b;
    color: #f8fafc;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 60px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .btn-switch i {
    color: #facc15;
    font-size: 1rem;
  }

  .btn-switch:hover {
    background: #0f172a;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 28px -10px rgba(0, 0, 0, 0.15);
  }

  /* ----- main card (view roster) ----- */
  .card-view {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 40px;
    padding: 2.8rem 2rem 3rem;
    box-shadow: 0 12px 30px -8px rgba(0, 20, 40, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.8);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.25s ease;
  }

  .card-view:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 30px 50px -18px rgba(0, 30, 50, 0.18);
  }

  /* icon circle */
  .icon-circle {
    width: 88px;
    height: 88px;
    background: #e0f2fe;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.4rem;
    font-size: 2.6rem;
    color: #2563eb;
    box-shadow: 0 8px 20px -8px rgba(37, 99, 235, 0.15);
  }

  .card-view h3 {
    font-weight: 700;
    font-size: 1.8rem;
    color: #0b1a2b;
    letter-spacing: -0.4px;
    margin-bottom: 0.3rem;
  }

  .card-view .sub-text {
    color: #475569;
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 1.8rem;
  }

  /* ----- form elements ----- */
  .month-input {
    width: 100%;
    padding: 0.9rem 1.4rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 60px;
    font-size: 1rem;
    font-weight: 500;
    background: white;
    color: #0f172a;
    outline: none;
    transition: 0.2s;
    margin-bottom: 1.2rem;
    font-family: 'Inter', sans-serif;
  }

  .month-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  /* preview image */
  .roster-preview {
    margin: 0.4rem 0 1.2rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .roster-preview img {
    width: 70%;
    max-width: 200px;
    height: auto;
    opacity: 0.7;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.02));
    transition: opacity 0.2s;
  }

  .roster-preview img:hover {
    opacity: 0.9;
  }

  /* view button */
  .btn-view {
    background: #2563eb;
    border: none;
    padding: 0.9rem 2.8rem;
    border-radius: 60px;
    font-weight: 600;
    font-size: 1.05rem;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 24px -8px rgba(37, 99, 235, 0.35);
    transition: all 0.25s ease;
    cursor: pointer;
    border: 1px solid transparent;
    margin-top: 0.2rem;
    font-family: 'Inter', sans-serif;
  }

  .btn-view i {
    font-size: 1.1rem;
  }

  .btn-view:hover {
    background: #1d4ed8;
    transform: scale(1.02);
    box-shadow: 0 14px 28px -10px rgba(37, 99, 235, 0.45);
  }

  .btn-view:active {
    transform: scale(0.98);
  }

  /* hidden role */
  .hidden-role {
    display: none;
  }

  /* responsive */
  @media (max-width: 540px) {
    .app-container {
      padding: 1.6rem 1.2rem;
      border-radius: 32px;
    }
    .card-view {
      padding: 2rem 1.2rem 2.2rem;
    }
    .top-bar {
      justify-content: center;
    }
    .btn-switch {
      padding: 0.6rem 1.4rem;
      font-size: 0.85rem;
    }
    .card-view h3 {
      font-size: 1.5rem;
    }
    .roster-preview img {
      width: 60%;
    }
  }

  /* fade-in animation */
  .fade-up {
    animation: fadeUp 0.5s ease forwards;
  }

  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(18px); }
    100% { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // ----- set default month to current month on page load -----
  window.onload = function() {
    // Set default month to current month
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const defaultMonth = year + '-' + month;
    document.getElementById('myViewMonth').value = defaultMonth;

    // Replace history (keeps original behaviour)
    window.history.replaceState({}, 'View NightChecklist', '<%=request.getContextPath() + "/jsp/ExcelRoster_new.jsp"%>');
  };

  // ----- view date (original logic) -----
  function viewDate() {
    var month = document.getElementById('myViewMonth').value;
    if (!month) {
      alert('Please select a month.');
      return;
    }
    // using the form
    document.forms[0].action = '<%=request.getContextPath() + "/jsp/testRoster1.jsp"%>';
    document.forms[0].submit();
  }

  // ----- switch to ROC (original) -----
  function openNewRocPage() {
    window.location.href = '<%=request.getContextPath() + "/jsp/ROCRoster.jsp"%>';
  }
</script>
</head>
<body>

<div class="app-container">

  <!-- top bar: switch to ROC -->
  <div class="top-bar">
    <button class="btn-switch" onclick="openNewRocPage()">
      <i class="fas fa-arrow-right-arrow-left"></i> Switch to ROC Roster
    </button>
  </div>

  <%
    // ---------- session & role (exactly as original) ----------
    session = request.getSession();
    String m_strrole = (String) session.getAttribute("role");
    String username = request.getParameter("user");
    System.out.println("User:- " + username);
    if (m_strrole == null) {
      m_strrole = request.getParameter("role");
      if (m_strrole != null) {
        session.setAttribute("role", m_strrole);
      }
    }
    System.out.println("Role:-" + m_strrole);
  %>

  <!-- main card: view roster only -->
  <div class="card-view fade-up">
    <div class="icon-circle">
      <i class="fas fa-eye"></i>
    </div>
    <h3>View Roster</h3>
    <p class="sub-text">Select a month to display the roster</p>

    <form id="viewForm" action="<%=request.getContextPath() + "/jsp/testRoster1.jsp"%>" method="get" style="width:100%;">
      <!-- month picker - default set via JavaScript -->
      <input type="month" id="myViewMonth" name="myViewMonth" class="month-input" required />

      <!-- hidden role (as original) -->
      <input type="hidden" name="m_strroles" value="<%=m_strrole != null ? m_strrole : "" %>" />

      <!-- image from original (5469.jpg) -->
      <div class="roster-preview">
        <img src="../images/5469.jpg" alt="roster preview" />
      </div>

      <!-- view button -->
      <button type="button" class="btn-view" onclick="viewDate()">
        <i class="fas fa-calendar-alt"></i> View Roster
      </button>
    </form>
  </div>

</div> <!-- end app-container -->

</body>
</html>
